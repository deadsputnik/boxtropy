<!DOCTYPE html>
<html lang="en">
<head>
<%- include("./partials/head.ejs", {title: "Containers - Boxtropy"}); %>
</head>
<body>
<header>
  <%- include("./partials/header", {button : button}) %>
</header>
<main>
    <div class="title-bar">
      <h1><%= title %>
      </h1>
    </div>
  <div class="scroll">
    <% containers.forEach((container) => { %>
      <%- include("./container-card", {container}) %>
      <% }) %>
    </div>
    </main>
    <footer>
<%- include("./partials/footer"); %>
    </footer>    
</body>
</html>