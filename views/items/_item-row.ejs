  <tr>
    <td class="tb-photo-col"><img class="table-photo" src="/<%-item.photourl%>" alt="<%item.name%>"></td>
    <td><%= item.name %></td>
    <td><%= item.quantity %></td>
    <td><%= item.containername %></td>
    <td class="tb-category"> <% item.categories.forEach((category) => { %>
      <a href="/category/<%= category.id %>" class="item-category" style="background-color: <%=category.color%>">
        <%=category.name%> 
      </a>
    <%})%>
    </td>
    <td><%= item.note %></td>
    <td><%= item.lastupdated ? item.lastupdated.toString().slice(4,24) : "" %></td>
    <td><%= item.created.toString().slice(4,24) %></td>
    <td><div class="item-btns">
      <a class="settings-btn" href="/UpdateItem/<%=item.id%>">Update</a>
                    <form action="/DeleteContainer" method="POST" >
                <button class="settings-btn" value="<%=item.id%>" onclick='return confirm("Are you sure you want to delete this item: <%=item.name%>?")' name="itemId"               
              >Delete</button>
            </form>
    </div></td>
  </tr>